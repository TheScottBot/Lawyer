DISCORD_TOKEN=your-bot-token-here
# Prefix for text commands, e.g. "!" gives "!rule poison". /rule always works too.
COMMAND_PREFIX=!
# Optional but recommended: comma-separated server IDs, so slash command changes show up instantly.
# Slash commands only work in the servers listed here. (Developer Mode -> right-click the server icon -> Copy Server ID)
# GUILD_IDS=111111111111111111,222222222222222222
# Optional: where the built rulebooks are (python -m lawyer.tools.rules_build <book> writes them). Defaults to rules/
# next to bot.py.
# RULES_DIR=rules
# Optional: where each server's settings (/settings) are kept. Defaults to lawyer.db next to bot.py.
# DB_PATH=lawyer.db
# Optional: rolling log file. Defaults to logs/lawyer.log (logs/lawyer-dev.log with --dev),
# rotating at 1 MB and keeping 5 old files.
# LOG_FILE=logs/lawyer.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUPS=5
